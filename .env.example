# ── Web reference app ───────────────────────────────────────────────────
# Local development only. Staging and production values live in Infisical and
# are injected at deploy time by Coolify (Section 12).

# This app's own database role. Read/write on the core_web schema, and no
# privilege of any kind on core (Section 5.5).
DATABASE_URL=postgres://core_web_rw:local_dev_only@localhost:5432/beorchid_core_dev

# ── Clerk ───────────────────────────────────────────────────────────────
# Leave both unset to run with the development stand-in. Setting a real
# publishable key switches authentication to Clerk with no code change.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# Where Clerk sends people. These routes exist already.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ── Google and Microsoft sign-in ────────────────────────────────────────
# There are deliberately no OAuth variables here.
#
# Google and Microsoft client IDs and secrets are entered in the CLERK
# DASHBOARD, per provider, per instance. Clerk performs the OAuth handshake and
# this app never holds or sees those credentials. Putting them here would be
# dead configuration describing a flow that does not exist.
#
# Where they actually go:
#   Clerk dashboard → Configure → SSO connections → Google / Microsoft
#   Backed up in Infisical under /clerk/<environment>/oauth/ for the record.
#
# Setup steps: core-api/docs/clerk-configuration.md

# ── Core API ────────────────────────────────────────────────────────────
# Leave unset to use StubCoreClient, which serves the same interface from a
# fixture. Setting both switches identity and permission resolution to the real
# Core API with no code change.
# CORE_API_URL=http://localhost:3000
# CORE_API_KEY=...
